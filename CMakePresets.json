{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 30, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
    },
    {
      "name": "dev",
      "displayName": "dev: RelWithDebInfo; Standalone, AU, VST3 and the probes",
      "inherits": [ "base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "release",
      "displayName": "release: Release, LTO; Standalone, AU, VST3 (scripts/install.sh copies these)",
      "inherits": [ "base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FP_LTO": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev",        "configurePreset": "dev",     "targets": [ "all", "probes" ], "jobs": 6 },
    { "name": "dev-probes", "configurePreset": "dev",     "targets": [ "probes" ],        "jobs": 6 },
    { "name": "release",    "configurePreset": "release", "targets": [ "all" ],           "jobs": 6 }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-probes",
      "configurePreset": "dev",
      "filter": { "include": { "label": "probe" } },
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev-verify",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "release-build",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    }
  ]
}
