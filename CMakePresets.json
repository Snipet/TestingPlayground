{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 30, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64", "FP_PRODUCTS": "" }
    },
    {
      "name": "dev",
      "displayName": "dev: RelWithDebInfo; both products' Standalone, AU, VST3 and probes",
      "inherits": [ "base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "release",
      "displayName": "release: Release, LTO; both products' Standalone, AU, VST3 (scripts/install.sh copies these)",
      "inherits": [ "base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FP_LTO": "ON" }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-cl", "CMAKE_CXX_COMPILER": "clang-cl", "FP_PRODUCTS": "" }
    },
    {
      "name": "windows-dev",
      "displayName": "windows-dev: RelWithDebInfo, x64, clang-cl; both products' Standalone, VST3 and probes",
      "inherits": [ "windows-base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-release",
      "displayName": "windows-release: Release, x64, clang-cl; both products' Standalone and VST3",
      "inherits": [ "windows-base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_LINKER_TYPE": "LLD",
                          "FP_PRODUCTS": "" }
    },
    {
      "name": "linux-dev",
      "displayName": "linux-dev: RelWithDebInfo, x86-64, clang and lld; both products' Standalone, VST3 and probes",
      "inherits": [ "linux-base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux-release",
      "displayName": "linux-release: Release, LTO, x86-64, clang and lld; both products' Standalone and VST3",
      "inherits": [ "linux-base" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FP_LTO": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev",           "configurePreset": "dev",     "targets": [ "all", "probes" ], "jobs": 6 },
    { "name": "dev-probes",    "configurePreset": "dev",     "targets": [ "probes" ],        "jobs": 6 },
    { "name": "dev-effect",    "configurePreset": "dev",     "targets": [ "effect" ],        "jobs": 6,
      "displayName": "the effect alone: its plugin, its extension and its probes" },
    { "name": "dev-synth",     "configurePreset": "dev",     "targets": [ "synth" ],         "jobs": 6,
      "displayName": "the synth alone: its plugin, its extension and its probes" },
    { "name": "release",       "configurePreset": "release", "targets": [ "all" ],           "jobs": 6 },
    { "name": "windows-dev",        "configurePreset": "windows-dev",     "targets": [ "all", "probes" ], "jobs": 6 },
    { "name": "windows-dev-effect", "configurePreset": "windows-dev",     "targets": [ "effect" ],        "jobs": 6 },
    { "name": "windows-dev-synth",  "configurePreset": "windows-dev",     "targets": [ "synth" ],         "jobs": 6 },
    { "name": "windows-release",    "configurePreset": "windows-release", "targets": [ "all" ],           "jobs": 6 },
    { "name": "linux-dev",          "configurePreset": "linux-dev",       "targets": [ "all", "probes" ], "jobs": 6 },
    { "name": "linux-dev-effect",   "configurePreset": "linux-dev",       "targets": [ "effect" ],        "jobs": 6 },
    { "name": "linux-dev-synth",    "configurePreset": "linux-dev",       "targets": [ "synth" ],         "jobs": 6 },
    { "name": "linux-release",      "configurePreset": "linux-release",   "targets": [ "all" ],           "jobs": 6 }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-probes",
      "configurePreset": "dev",
      "filter": { "include": { "label": "probe" } },
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-effect",
      "displayName": "the effect's probes (the lints need both products built)",
      "configurePreset": "dev",
      "filter": { "include": { "label": "^effect$" } },
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-synth",
      "displayName": "the synth's probes (the lints need both products built)",
      "configurePreset": "dev",
      "filter": { "include": { "label": "^synth$" } },
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-dev-effect",
      "configurePreset": "windows-dev",
      "filter": { "include": { "label": "^effect$" } },
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-dev-synth",
      "configurePreset": "windows-dev",
      "filter": { "include": { "label": "^synth$" } },
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-dev-effect",
      "configurePreset": "linux-dev",
      "filter": { "include": { "label": "^effect$" } },
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-dev-synth",
      "configurePreset": "linux-dev",
      "filter": { "include": { "label": "^synth$" } },
      "execution": { "jobs": 6, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev-verify",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "effect-verify",
      "displayName": "the effect alone: configure, build, its probes",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev-effect" },
        { "type": "test", "name": "dev-effect" }
      ]
    },
    {
      "name": "synth-verify",
      "displayName": "the synth alone: configure, build, its probes",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev-synth" },
        { "type": "test", "name": "dev-synth" }
      ]
    },
    {
      "name": "release-build",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    },
    {
      "name": "windows-verify",
      "displayName": "Windows: configure, build (both products) and run every test",
      "steps": [
        { "type": "configure", "name": "windows-dev" },
        { "type": "build", "name": "windows-dev" },
        { "type": "test", "name": "windows-dev" }
      ]
    },
    {
      "name": "windows-effect-verify",
      "displayName": "Windows: the effect alone",
      "steps": [
        { "type": "configure", "name": "windows-dev" },
        { "type": "build", "name": "windows-dev-effect" },
        { "type": "test", "name": "windows-dev-effect" }
      ]
    },
    {
      "name": "windows-synth-verify",
      "displayName": "Windows: the synth alone",
      "steps": [
        { "type": "configure", "name": "windows-dev" },
        { "type": "build", "name": "windows-dev-synth" },
        { "type": "test", "name": "windows-dev-synth" }
      ]
    },
    {
      "name": "windows-release-build",
      "displayName": "Windows: Release build of both products",
      "steps": [
        { "type": "configure", "name": "windows-release" },
        { "type": "build", "name": "windows-release" }
      ]
    },
    {
      "name": "linux-verify",
      "displayName": "Linux: configure, build (both products) and run every test (GUI probes need an X display)",
      "steps": [
        { "type": "configure", "name": "linux-dev" },
        { "type": "build", "name": "linux-dev" },
        { "type": "test", "name": "linux-dev" }
      ]
    },
    {
      "name": "linux-effect-verify",
      "displayName": "Linux: the effect alone",
      "steps": [
        { "type": "configure", "name": "linux-dev" },
        { "type": "build", "name": "linux-dev-effect" },
        { "type": "test", "name": "linux-dev-effect" }
      ]
    },
    {
      "name": "linux-synth-verify",
      "displayName": "Linux: the synth alone",
      "steps": [
        { "type": "configure", "name": "linux-dev" },
        { "type": "build", "name": "linux-dev-synth" },
        { "type": "test", "name": "linux-dev-synth" }
      ]
    },
    {
      "name": "linux-release-build",
      "displayName": "Linux: Release build of both products",
      "steps": [
        { "type": "configure", "name": "linux-release" },
        { "type": "build", "name": "linux-release" }
      ]
    }
  ]
}
