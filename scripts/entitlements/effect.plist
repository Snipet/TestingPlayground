<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  scripts/entitlements/effect.plist: the hardened runtime's entitlements of an effect's Standalone app (a product whose
  PRODUCT_KIND is effect), which scripts/package.sh signs it with. The AU and the VST3 run in their host's process with
  the host's entitlements, and the MCP server needs none: they are signed without.

  allow-unsigned-executable-memory: FMinus compiles the program with LLVM's JIT, whose memory manager (JITLink's
  InProcessMemoryManager, LLVM 23) maps pages read-write without MAP_JIT and then makes them executable. Measured: under
  the hardened runtime a binary without it, or with com.apple.security.cs.allow-jit alone, is killed at the first
  compile; with it, it runs.
  audio-input: the effect processes the audio input (its Info.plist's NSMicrophoneUsageDescription says why).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
