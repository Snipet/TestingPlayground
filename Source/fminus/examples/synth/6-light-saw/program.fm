// Light saw: a band-limited sawtooth through a resonant low-pass whose brightness is a dial drawn by a shader (dial.sc,
// beside it in panel.gui), lit while the pointer is over it or holds it: drag it up or down. Hold the pointer down on
// the scope under it to open the filter all the way, as a wah's pedal (swell, high while pressed), and drag across it
// to set the brightness. The saw and the filter are the Saw and filter example's.

// The polyBLEP correction for a sawtooth at phase t (0 to 1) stepping dt a sample: it rounds off the jump at the wrap.
float blep(float t, float dt)
{
    if (t < dt)
    {
        const float x = t / dt;
        return x + x - x * x - 1;
    }
    if (t > 1 - dt)
    {
        const float x = (t - 1) / dt;
        return x * x + x + x + 1;
    }
    return 0;
}

module Voice
{
    param float bright [[fminus::range(0, 1)]] [[fminus::default(0.4)]];        // the cutoff: 40 Hz at 0, 12 kHz at 1
    param float resonance [[fminus::range(0, 1)]] [[fminus::default(0.4)]];
    param bool swell [[fminus::default(0)]];                                     // the filter wide open while held
    param float release [[fminus::range(10, 4000)]] [[fminus::default(300)]];   // ms
    param float level [[fminus::range(-36, 0)]] [[fminus::default(-15)]];       // dB
    float rate;
    float phase;
    float step;
    float velocity;
    float env;
    float open;      // the swell, gliding to 0 or 1 over about 30 ms
    bool held;
    float ic1;       // the filter's states
    float ic2;

    void init(float sampleRate)
    {
        rate = sampleRate;
    }

    void start(float note, float vel)
    {
        step = 440 * expf(0.0577622650f * (note - 69)) / rate;
        velocity = vel;
        phase = 0;
        env = 0;         // an instance a stolen voice left is still at its level and its filter's: start from 0
        open = 0;
        ic1 = 0;
        ic2 = 0;
        held = true;
    }

    void stop()
    {
        held = false;
    }

    bool process(float* restrict left, float* restrict right, int n)
    {
        const float up = 1000 / (5 * rate);                                // a 5 ms attack
        const float down = expf(-6907.7553f / (release[0] * rate));       // -60 dB in `release` ms
        const float glide = 1 - expf(-1000 / (30 * rate));
        const float gain = velocity * expf(0.115129255f * level[0]);
        const float k = 2 - 1.9f * resonance[0];                          // 1 / Q
        for (int i = 0; i < n; ++i)
        {
            if (held)
                env = fminf(env + up, 1);
            else
                env *= down;
            const float target = swell[i] ? 1.0f : 0.0f;
            open += glide * (target - open);

            const float saw = 2 * phase - 1 - blep(phase, step);
            phase += step;
            if (phase >= 1)
                phase -= 1;

            // The cutoff, 40 Hz times 300 to the brightness (opened by the swell); g = tan(pi fc / fs).
            const float b = bright[i] + (1 - bright[i]) * open;
            const float fc = 40 * expf(5.70378247f * b);
            const float w = fminf(3.14159265f * fc / rate, 1.5f);
            const float g = sinf(w) / cosf(w);
            const float a1 = 1 / (1 + g * (g + k));
            const float a2 = g * a1;
            const float a3 = g * a2;
            const float v3 = saw - ic2;
            const float v1 = a1 * ic1 + a2 * v3;
            const float v2 = ic2 + a2 * ic1 + a3 * v3;
            ic1 = 2 * v1 - ic1;
            ic2 = 2 * v2 - ic2;

            const float out = gain * env * v2;
            left[i] += out;
            right[i] += out;
        }
        return held || env > 0.0001f;
    }
};
