// Init: a clean start for a sound: one oscillator, a low-pass filter wide open and an envelope on the level, a plain
// sawtooth that starts and stops without a click. Turn CUTOFF down and ENV AMOUNT up for the classic sweep, or edit
// module Voice at the bottom, then press RUN (or Cmd-Return).
//
// The plugin plays a module Voice, one instance a note, sixteen at once. start gets the MIDI note (69 is A, 440 Hz)
// and its velocity (0 to 1), stop the key's release, and process the voice's next n samples into both channels, which
// arrive at 0, returning false once the voice is silent for good: that frees it. The params are the dials under the
// editor, up to 32, the same in every voice: a float is read sample by sample, cutoff[i], and glides when its dial
// turns; an int or a bool is read once a call. host (host.fm, a file the plugin provides) is what the host and the
// player are doing: the pitch wheel bends the note up to 2 semitones, and the mod wheel, host->modwheel, is yours.
#include "host.fm"
#pragma panel section "OSC" wave
#pragma panel section "FILTER" cutoff resonance amount
#pragma panel section "AMP" attack decay sustain release
#pragma panel section "OUTPUT" volume out
#pragma panel options wave "SAW" "SQUARE" "TRI" "SINE"
#pragma panel style wave buttons
#pragma panel label amount "ENV AMOUNT"
#pragma panel style attack decay sustain release fader
#pragma panel meter out "OUT"

// The building blocks, Osc, Svf and Adsr, are the library's osc.fm, svf.fm and adsr.fm, cut down and copied in so that
// the program stands alone (delete one before you add its library file with LIBRARY).

// Band-limited oscillators (polyBLEP and polyBLAMP: no harsh aliasing up the keyboard). Each call is one sample, -1
// to 1, and advances the phase by step, the frequency in cycles a sample; reset(phase) starts a cycle there.
module Osc
{
    float phase;

    void reset(float at)
    {
        phase = at - floorf(at);
    }

    // The polyBLEP correction for a step of -2 at phase 0 (t: the phase, dt: its step a sample).
    float blep(float t, float dt)
    {
        if (t < dt)
        {
            const float x = t / dt;
            return x + x - x * x - 1;
        }
        if (t > 1 - dt)
        {
            const float x = (t - 1) / dt;
            return x * x + x + x + 1;
        }
        return 0;
    }

    // The polyBLAMP correction for a corner whose slope rises by one a sample, at phase 0.
    float blamp(float t, float dt)
    {
        if (t < dt)
        {
            const float x = 1 - t / dt;
            return x * x * x * 0.166666667f;
        }
        if (t > 1 - dt)
        {
            const float x = (t - 1) / dt + 1;
            return x * x * x * 0.166666667f;
        }
        return 0;
    }

    void advance(float dt)
    {
        phase += dt;
        if (phase >= 1)
            phase -= 1;
    }

    float saw(float step)
    {
        const float dt = fminf(fabsf(step), 0.5f);
        const float y = 2 * phase - 1 - blep(phase, dt);
        advance(dt);
        return y;
    }

    // High for `width` of the cycle (0.5: a square), its mean taken off.
    float pulse(float step, float width)
    {
        const float dt = fminf(fabsf(step), 0.5f);
        const float w = fminf(fmaxf(width, 0.05f), 0.95f);
        float t2 = phase - w;
        if (t2 < 0)
            t2 += 1;
        const float y = (phase < w ? 1.0f : -1.0f) + blep(phase, dt) - blep(t2, dt) + 1 - 2 * w;
        advance(dt);
        return y;
    }

    float triangle(float step)
    {
        const float dt = fminf(fabsf(step), 0.5f);
        float t2 = phase + 0.5f;
        if (t2 >= 1)
            t2 -= 1;
        const float y = 1 - 4 * fabsf(phase - 0.5f) + 8 * dt * (blamp(phase, dt) - blamp(t2, dt));
        advance(dt);
        return y;
    }

    float sine(float step)
    {
        const float y = sinf(6.28318531f * phase);
        advance(fminf(fabsf(step), 0.5f));
        return y;
    }
};

// A state-variable filter, 12 dB/octave (Simper's topology-preserving form: stable however fast its cutoff moves).
// set(fc, res, rate): the cutoff in Hz, the resonance 0 (none) to 1 (it rings); tick(x) one sample, the low-pass out
// and lp, bp, hp and notch in its fields; clear() silence.
module Svf
{
    float lp;
    float bp;
    float hp;
    float notch;
    float ic1;
    float ic2;
    float k;
    float a1;
    float a2;
    float a3;

    void set(float fc, float res, float rate)
    {
        const float r = fmaxf(rate, 1000);
        const float w = 3.14159265f * fminf(fmaxf(fc, 5), 0.49f * r) / r;
        // sin and cos in one call: cos(w) is sin(pi / 2 - w), pi / 2 in two parts so that it keeps its accuracy.
        const float2 sc = sinf((float2)(w, 1.57079637f - w - 4.37113883e-8f));
        setG(sc.x / sc.y, res);
    }

    void setG(float g, float res)
    {
        k = 2 - 1.95f * fminf(fmaxf(res, 0), 1);
        a1 = 1 / (1 + g * (g + k));
        a2 = g * a1;
        a3 = g * a2;
    }

    float tick(float x)
    {
        const float v3 = x - ic2;
        const float v1 = a1 * ic1 + a2 * v3;
        const float v2 = ic2 + a2 * ic1 + a3 * v3;
        ic1 = 2 * v1 - ic1;
        ic2 = 2 * v2 - ic2;
        lp = v2;
        bp = k * v1;
        hp = x - k * v1 - v2;
        notch = x - k * v1;
        return v2;
    }

    void clear()
    {
        ic1 = 0;
        ic2 = 0;
    }
};

// An ADSR envelope with an analog's curves: the attack rises as a capacitor charges, the decay and release fall
// exponentially (to 60 dB down in their times). set(...) once a call; gate(true) in start, gate(false) in stop;
// tick() one sample, 0 to 1; active() false once the release has ended.
module Adsr
{
    float level;
    int stage;     // 0 idle, 1 attack, 2 decay and sustain, 3 release
    float rise;
    float fall;
    float sustain;
    float down;

    void set(float attackMs, float decayMs, float sustainLevel, float releaseMs, float rate)
    {
        const float r = fmaxf(rate, 1000);
        // The attack charges toward 1.3 and stops at 1, which it reaches in attackMs: 1.466 time constants.
        rise = 1 - expf(-1.46633707f / (fmaxf(attackMs, 0.5f) * 0.001f * r));
        fall = expf(-6.90775528f / (fmaxf(decayMs, 1) * 0.001f * r));
        sustain = fminf(fmaxf(sustainLevel, 0), 1);
        down = expf(-6.90775528f / (fmaxf(releaseMs, 1) * 0.001f * r));
    }

    void gate(bool on)
    {
        if (on)
            stage = 1;
        else if (stage != 0)
            stage = 3;
    }

    float tick()
    {
        if (stage == 1)
        {
            level += rise * (1.3f - level);
            if (level >= 1)
            {
                level = 1;
                stage = 2;
            }
        }
        else if (stage == 2)
            level = sustain + fall * (level - sustain);
        else if (stage == 3)
        {
            level *= down;
            if (level < 0.0001f)
            {
                level = 0;
                stage = 0;
            }
        }
        return level;
    }

    bool active()
    {
        return stage != 0;
    }
};

module Voice
{
    param int wave [[fminus::range(0, 3)]] [[fminus::default(0)]];              // SAW, SQUARE, TRI, SINE
    param float cutoff [[fminus::range(0, 10)]] [[fminus::default(10)]];        // octaves above 20 Hz: 10 is 20 kHz
    param float resonance [[fminus::range(0, 1)]] [[fminus::default(0)]];
    param float amount [[fminus::range(0, 10)]] [[fminus::default(0)]];         // octaves the envelope opens it
    param float attack [[fminus::range(1, 2000)]] [[fminus::default(2)]];       // ms
    param float decay [[fminus::range(10, 4000)]] [[fminus::default(300)]];     // ms, toward the sustain level
    param float sustain [[fminus::range(0, 1)]] [[fminus::default(1)]];
    param float release [[fminus::range(10, 4000)]] [[fminus::default(100)]];   // ms, to -60 dB
    param float volume [[fminus::range(-48, 0)]] [[fminus::default(-12)]];      // dB
    Host* host;        // the plugin points it at the Host: the tempo, the wheels, the pedal
    Osc osc;
    Svf filter;
    Adsr amp;
    float rate;
    float step;        // the note's frequency, in cycles a sample
    float velocity;

    void init(float sampleRate)
    {
        rate = sampleRate;
    }

    void start(float note, float vel)
    {
        step = 440 * expf(0.0577622650f * (note - 69)) / rate;   // 2^((note - 69) / 12)
        velocity = vel;
        osc.reset(0);
        filter.clear();
        amp.gate(true);
    }

    void stop()
    {
        amp.gate(false);
    }

    bool process(float* restrict left, float* restrict right, int n)
    {
        amp.set(attack[0], decay[0], sustain[0], release[0], rate);
        const float f = step * expf(0.0577622650f * 2 * host->pitchbend);   // the pitch wheel: 2 semitones
        const float gain = velocity * expf(0.115129255f * volume[0]);      // the velocity on the level
        const int shape = wave[0];
        for (int i = 0; i < n; ++i)
        {
            // The oscillator.
            float x = 0;
            if (shape == 0)
                x = osc.saw(f);
            else if (shape == 1)
                x = osc.pulse(f, 0.5f);
            else if (shape == 2)
                x = osc.triangle(f);
            else
                x = osc.sine(f);

            // The filter: its cutoff 20 Hz times 2^octaves, the envelope opening it by AMOUNT octaves.
            const float env = amp.tick();
            filter.set(20 * expf(0.693147181f * (cutoff[i] + amount[i] * env)), resonance[i], rate);
            const float y = filter.tick(x);

            // The amplifier.
            const float out = gain * env * y;
            left[i] += out;
            right[i] += out;
        }
        return amp.active();
    }
};
