// Light filter: a resonant low-pass whose cutoff is a dial drawn by a shader (dial.sc, beside it in panel.gui), lit
// while the pointer is over it or holds it: drag it up or down. Or drag across the spectrum under it: the cutoff
// follows the pointer from left to right, as the spectrum reads (20 Hz to 20 kHz), and the resonance up and down. The
// state-variable filter is the Filter example's, its low-pass alone.
module Svf
{
    float ic1;   // the integrators' states
    float ic2;

    // One sample of the low-pass: g = tan(pi fc / fs), k = 1 / Q.
    float tick(float x, float g, float k)
    {
        const float a1 = 1 / (1 + g * (g + k));
        const float a2 = g * a1;
        const float a3 = g * a2;
        const float v3 = x - ic2;
        const float v1 = a1 * ic1 + a2 * v3;
        const float v2 = ic2 + a2 * ic1 + a3 * v3;
        ic1 = 2 * v1 - ic1;
        ic2 = 2 * v2 - ic2;
        return v2;
    }
};

module Effect
{
    param float tone [[fminus::range(0, 1)]] [[fminus::default(0.7)]];          // the cutoff: 20 Hz at 0, 20 kHz at 1
    param float resonance [[fminus::range(0, 1)]] [[fminus::default(0.3)]];     // Q from 0.5 to 25
    Svf l;
    Svf r;
    float piOverRate;

    void init(float rate)
    {
        piOverRate = 3.14159265f / rate;
    }

    void process(float* restrict left, float* restrict right, int n)
    {
        for (int i = 0; i < n; ++i)
        {
            const float cutoff = 20 * expf(6.90775528f * tone[i]);     // 20 Hz times 1000 to the tone
            const float w = fminf(piOverRate * cutoff, 1.5f);           // below pi / 2: tan stays finite
            const float g = sinf(w) / cosf(w);
            const float k = 2 - 1.96f * resonance[i];
            left[i] = l.tick(left[i], g, k);
            right[i] = r.tick(right[i], g, k);
        }
    }
};
