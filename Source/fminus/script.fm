// Source/fminus/script.fm: TestingPlayground's FMinus script, an auto-panner on the reverb's output, run on the audio
// thread (README.md, "FMinus"). Edit it while the plugin runs: save, and half a second later the plugin plays it,
// faded over from the old one; script.fm.log, beside this file, says whether it compiled. The plugin keeps a copy of it
// as it was when it was built, for when this file is not there.
//
// SCRIPT (0 to 100 %) arrives as `amount`, per sample: at 0 the sound is as it was, and at 100 % it swings fully from
// one side to the other, twice a second.

// The state: the phase step a sample, and the phase, 0 to 1.
float* create(float rate)
{
    float* state = calloc(2, sizeof(float));
    state[0] = 2.0f / rate;   // 2 Hz
    return state;
}

// n samples of both channels, in place: each side's level dips in turn, as `amount` says.
void process(float* restrict state, float* restrict left, float* restrict right, const float* restrict amount,
             int n) [[clang::nonblocking]]
{
    const float step = state[0];
    float phase = state[1];
    for (int i = 0; i < n; ++i)
    {
        const float swing = 0.5f + 0.5f * cosf(6.28318531f * phase);   // 1, 0, 1, ...
        left[i] *= 1.0f - amount[i] * swing;
        right[i] *= 1.0f - amount[i] * (1.0f - swing);
        phase += step;
        if (phase >= 1.0f)
            phase -= 1.0f;
    }
    state[1] = phase;
}

void destroy(float* state)
{
    free(state);
}
