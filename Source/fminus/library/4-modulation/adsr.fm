// adsr.fm: an ADSR envelope with an analog's curves.
//
// The attack rises as a capacitor charges (fast, then easing into the top), the decay and release fall
// exponentially. A gate while it sounds starts the attack from where it is, so a retriggered note does not click.
//
//   Adsr env;                      a field of your voice
//   env.set(attack, decay, sustain, release, rate);
//                                  the times in ms (the decay and release: to 60 dB down), sustain 0 to 1; once a
//                                  call (three expf)
//   env.gate(true);                in start; env.gate(false) in stop
//   y = env.tick();                one sample, 0 to 1
//   env.active()                   false once the release has ended (80 dB down: 1.1 to 1.3 times the release
//                                  time): an instrument's process returns it
//   env.level  env.stage           where it is; the stage: 0 idle, 1 attack, 2 decay and sustain, 3 release
module Adsr
{
    float level;
    int stage;
    float rise;
    float fall;
    float sustain;
    float down;

    void set(float attackMs, float decayMs, float sustainLevel, float releaseMs, float rate)
    {
        const float r = fmaxf(rate, 1000);
        // The attack charges toward 1.3 and stops at 1, which it reaches in attackMs: 1.466 time constants.
        rise = 1 - expf(-1.46633707f / (fmaxf(attackMs, 0.5f) * 0.001f * r));
        fall = expf(-6.90775528f / (fmaxf(decayMs, 1) * 0.001f * r));
        sustain = fminf(fmaxf(sustainLevel, 0), 1);
        down = expf(-6.90775528f / (fmaxf(releaseMs, 1) * 0.001f * r));
    }

    void gate(bool on)
    {
        if (on)
            stage = 1;
        else if (stage != 0)
            stage = 3;
    }

    float tick()
    {
        if (stage == 1)
        {
            level += rise * (1.3f - level);
            if (level >= 1)
            {
                level = 1;
                stage = 2;
            }
        }
        else if (stage == 2)
            level = sustain + fall * (level - sustain);
        else if (stage == 3)
        {
            level *= down;
            if (level < 0.0001f)
            {
                level = 0;
                stage = 0;
            }
        }
        return level;
    }

    bool active()
    {
        return stage != 0;
    }
};
