// noise.fm: white, pink and brown noise.
//
// White is flat, pink falls 3 dB an octave (softer, like rain), brown 6 dB (a rumble). Two Noise fields given
// different seeds do not repeat each other.
//
//   Noise noise;                   a field of your module
//   noise.seed(n);                 optional: another sequence, from its start (two voices, two seeds)
//   y = noise.white();             -1 to 1, uniform; or
//   y = noise.pink();              as loud as white (the same RMS; its peaks reach about 3); or
//   y = noise.brown();             the same
//   noise.fill(w, n);              n white samples into w, as n calls of white() give them, in a loop that
//                                  vectorises: a block's noise in a loop of its own, then w[i] where it is mixed
// Each draws the next value: call one of them a sample. White is FMinus's randf of a count of samples, a few integer
// instructions a sample with no state but the count, the same sequence at any block size.
module Noise
{
    int key;
    int count;
    float b0;
    float b1;
    float b2;
    float br;

    void seed(int n)
    {
        key = hash(n);
        count = 0;
    }

    float white()
    {
        const float x = randf(key ^ count);
        count = (count + 1) & 0x3FFFFFFF;          // 2^30 samples (6 hours at 48 kHz), then again: no int overflows
        return x;
    }

    void fill(float* restrict w, int n)
    {
        for (int i = 0; i < n; ++i)
            w[i] = randf(key ^ ((count + i) & 0x3FFFFFFF));
        count = (count + n) & 0x3FFFFFFF;
    }

    // Uniform in (0, 1], in steps of 2^-24: never 0, so logf(uniform()) stays finite (Box-Muller, Poisson intervals).
    // 0.50000006f is 0.5 + 2^-24, so each value is exact.
    float uniform()
    {
        return 0.5f * white() + 0.50000006f;
    }

    // Paul Kellet's economy filter: three one-poles that sum to -3 dB/octave.
    float pink()
    {
        const float w = white();
        b0 = 0.99765f * b0 + w * 0.0990460f;
        b1 = 0.96300f * b1 + w * 0.2965164f;
        b2 = 0.57000f * b2 + w * 1.0526913f;
        return 0.335f * (b0 + b1 + b2 + w * 0.1848f);
    }

    // White, integrated, leaking a little so that it stays near 0.
    float brown()
    {
        br = 0.998f * br + 0.05f * white();
        return 1.25f * br;
    }
};
