# cmake/BuildCommit.cmake: writes BuildCommit.h, this build's commit (`git describe --always --dirty`, "unknown"
# outside a checkout or without git), for the Debug page (Source/plugin/ProcessorDebug.cpp, the one file that includes
# it). Run with cmake -P at configure and at every build (CMakeLists.txt's fp_build_commit), it rewrites the file only
# when the commit changed: a commit recompiles that one file, never what includes Product.h.
#   -DFP_SOURCE_DIR=<the checkout> -DFP_OUT=<the header's path>
if(NOT FP_SOURCE_DIR OR NOT FP_OUT)
  message(FATAL_ERROR "BuildCommit.cmake: FP_SOURCE_DIR and FP_OUT are required")
endif()
set(_commit "unknown")
find_program(_fp_git git)
if(_fp_git)
  execute_process(COMMAND ${_fp_git} describe --always --dirty
                  WORKING_DIRECTORY ${FP_SOURCE_DIR}
                  OUTPUT_VARIABLE _out ERROR_QUIET RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(_rc EQUAL 0 AND _out MATCHES "^[0-9A-Za-z._/+-]+$")
    set(_commit "${_out}")
  endif()
endif()
set(_text "// BuildCommit.h: generated by cmake/BuildCommit.cmake at every build. Do not edit; include it from\n"
          "// Source/plugin/ProcessorDebug.cpp alone (a commit then recompiles that file only).\n"
          "#pragma once\n\n"
          "#define FP_BUILD_COMMIT \"${_commit}\"\n")
string(CONCAT _text ${_text})
set(_old "")
if(EXISTS "${FP_OUT}")
  file(READ "${FP_OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
  file(WRITE "${FP_OUT}" "${_text}")
endif()
