# cmake/Installer.cmake: the installer, one app for every product (Source/installer/): "<Project> Installer.app", a JUCE
# GUI app whose window is a FunkGui Panel, with the products' bundles and extensions inside it as its payload. Its
# probes are one executable of their own (Tools/probes/installer/). README.md "Install" says how it is used.
#
#   fp_add_installer()   after every product (CMakeLists.txt): the name, the generated header, the payload's manifest,
#                        the app (target Installer), its payload (target installer_payload) and the probes
#                        (Installer_probes; tests installer.<name>, labels probe and installer)
#
# The project's name is the products' names' common start (TestingPlayground and TestingPlaygroundSynth:
# TestingPlayground; scripts/package.sh names the .pkg by the same rule), else the first product's name: it lives in
# products/*.cmake alone, so renaming the products (scripts/plugin.py rename) renames the installer. CMake works it out
# once here: FP_PROJECT_NAME and FP_INSTALLER_NAME ("<project> Installer") reach the code through the generated
# Installer.h, the payload through payload.json, and scripts/package.sh through the cache. The installer takes the
# first product's company, version and bundle id (".installer" after it), and its kind's icon (Assets/logo/<kind>/).
#
# The payload: every built product's AU, VST3 and Standalone bundles and its <Name>.mcpb, cloned (ditto --clone: on
# APFS a copy costs neither time nor space) into <Installer>.app/Contents/Resources/payload/ with payload.json, after
# all of them and the app are built; then the app is signed again, ad hoc, so its seal covers the payload (package.sh
# --installer signs it with a Developer ID instead). Every build that builds the app builds its payload: the release
# build's is what scripts/package.sh --installer ships (build-release/dist/<Installer>-<version>.dmg).
include_guard(GLOBAL)

function(fp_add_installer)
  # ---- the products, read again (fp_add_product's values live in its own scope) --------------------------------------
  set(_names "")
  set(_products_json "")
  set(_items "")
  set(_item_targets "")
  set(_mcpbs "")
  set(_first "")
  foreach(_k IN LISTS _fp_products)
    foreach(_v NAME KIND VERSION COMPANY BUNDLE_ID ENV_PREFIX OBJC_PREFIX)
      unset(PRODUCT_${_v})
    endforeach()
    include(${PROJECT_SOURCE_DIR}/products/${_k}.cmake)
    list(APPEND _names "${PRODUCT_NAME}")
    if(_first STREQUAL "")
      set(_first ${_k})
      set(_company "${PRODUCT_COMPANY}")
      set(_version "${PRODUCT_VERSION}")
      set(_bundle_id "${PRODUCT_BUNDLE_ID}.installer")
      set(_kind "${PRODUCT_KIND}")
      set(_env "${PRODUCT_ENV_PREFIX}INSTALLER_")
      set(_objc "${PRODUCT_OBJC_PREFIX}Installer")
    endif()
    if(NOT _products_json STREQUAL "")
      string(APPEND _products_json ",\n")
    endif()
    string(APPEND _products_json "    { \"key\": \"${_k}\", \"name\": \"${PRODUCT_NAME}\", \"kind\": \"${PRODUCT_KIND}\", "
                                 "\"company\": \"${PRODUCT_COMPANY}\", \"bundleId\": \"${PRODUCT_BUNDLE_ID}\", "
                                 "\"version\": \"${PRODUCT_VERSION}\" }")
    foreach(_fmt AU VST3 Standalone)
      list(APPEND _items "$<TARGET_BUNDLE_DIR:${PRODUCT_NAME}_${_fmt}>")
      list(APPEND _item_targets ${PRODUCT_NAME}_${_fmt})
    endforeach()
    list(APPEND _items "${CMAKE_BINARY_DIR}/${PRODUCT_NAME}.mcpb")
    list(APPEND _mcpbs "${CMAKE_BINARY_DIR}/${PRODUCT_NAME}.mcpb")
    list(APPEND _item_targets ${PRODUCT_NAME}MCP_mcpb)
  endforeach()

  # ---- the project's name: the names' common start (at least 4 characters), else the first's ------------------------
  list(GET _names 0 _project)
  foreach(_n IN LISTS _names)
    string(FIND "${_n}" "${_project}" _at)
    while(NOT _at EQUAL 0 AND NOT _project STREQUAL "")
      string(LENGTH "${_project}" _len)
      math(EXPR _len "${_len} - 1")
      string(SUBSTRING "${_project}" 0 ${_len} _project)
      string(FIND "${_n}" "${_project}" _at)
    endwhile()
  endforeach()
  string(LENGTH "${_project}" _len)
  if(_len LESS 4)
    list(GET _names 0 _project)
  endif()
  set(FP_PROJECT_NAME "${_project}" CACHE INTERNAL "The project's name: the products' names' common start")
  set(FP_INSTALLER_NAME "${_project} Installer" CACHE INTERNAL "The installer app's name (scripts/package.sh reads it)")
  set(FP_INSTALLER_VERSION "${_version}" CACHE INTERNAL "The installer's version: the first product's")

  # ---- the generated header and the payload's manifest -------------------------------------------------------------
  set(_gen ${CMAKE_BINARY_DIR}/generated/installer)
  file(CONFIGURE OUTPUT ${_gen}/Installer.h @ONLY CONTENT [=[// Installer.h: generated by cmake/Installer.cmake (<build>/generated/installer/). Do not edit: the names come from
// products/*.cmake. The installer's identity, for Source/installer/.
#pragma once

namespace @FP_NAMESPACE@::installer::info
{
    inline constexpr char kName[]           = "@FP_INSTALLER_NAME@";     // the app's name
    inline constexpr char kProject[]        = "@FP_PROJECT_NAME@";
    inline constexpr char kVersion[]        = "@_version@";
    inline constexpr char kCompany[]        = "@_company@";
    inline constexpr char kBundleId[]       = "@_bundle_id@";
    inline constexpr char kFunkGuiVersion[] = "@FUNKGUI_VERSION@";
    inline constexpr char kJuceVersion[]    = "@FP_JUCE_TAG@";
}
]=])
  set(_manifest ${CMAKE_BINARY_DIR}/installer/payload.json)
  file(CONFIGURE OUTPUT ${_manifest} @ONLY CONTENT [=[{
  "format": "funk-playground-payload",
  "version": 1,
  "project": "@FP_PROJECT_NAME@",
  "products": [
@_products_json@
  ]
}
]=])

  # ---- the app -----------------------------------------------------------------------------------------------------
  file(GLOB _src CONFIGURE_DEPENDS ${FP_SOURCE_ROOT}/installer/*.cpp ${FP_SOURCE_ROOT}/installer/*.mm)
  set(_engine_src ${_src})
  list(FILTER _engine_src EXCLUDE REGEX "/App\\.(cpp|mm)$")      # the probes take everything but the app's main
  fp_warn_sources(${_src})
  set(_logo ${PROJECT_SOURCE_DIR}/Assets/logo/${_kind})
  juce_add_gui_app(Installer
      PRODUCT_NAME   "${FP_INSTALLER_NAME}"
      VERSION        ${_version}
      BUNDLE_ID      ${_bundle_id}
      COMPANY_NAME   "${_company}"
      ICON_BIG       ${_logo}/installer-1024.png)
  get_target_property(_icns Installer JUCE_ICON_FILE)
  configure_file(${_logo}/icon.icns ${_icns} COPYONLY)            # every size drawn for itself, as the products'
  # The window: the Standalone's (Source/plugin/standalone/NativeWindow.mm: its transparent title bar over the content,
  # the buttons kept where the Panel wants them), compiled here too; CMakeLists.txt gives it its warnings and ARC.
  target_sources(Installer PRIVATE ${_src} ${FP_SOURCE_ROOT}/plugin/standalone/NativeWindow.mm)
  target_include_directories(Installer PRIVATE ${FP_SOURCE_ROOT} ${_gen})
  target_compile_definitions(Installer PRIVATE JUCE_WEB_BROWSER=0 JUCE_USE_CURL=0)
  target_link_libraries(Installer PRIVATE fp_flags juce::juce_gui_basics juce::juce_audio_processors FunkGui::core FunkGui::gpu
                                          "-framework Security" "-framework CoreFoundation"
                                  PUBLIC juce::juce_recommended_config_flags)
  if(FP_LTO)
    target_link_libraries(Installer PUBLIC juce::juce_recommended_lto_flags)
  endif()
  funkgui_configure_product(Installer PRODUCT "${FP_INSTALLER_NAME}" OBJC_PREFIX ${_objc} ENV_PREFIX ${_env}
                            PREFS_FOLDER "${FP_INSTALLER_NAME}")
  funkgui_compile_shaders(Installer)
  funkgui_add_font(Installer)

  # ---- its payload: the products' bundles and extensions, then the app's signature over them -----------------------
  list(JOIN _items "|" _items_arg)
  set(_stamp ${CMAKE_BINARY_DIR}/installer/payload.stamp)
  add_custom_command(OUTPUT ${_stamp}
      COMMAND ${CMAKE_COMMAND} "-DAPP=$<TARGET_BUNDLE_DIR:Installer>" "-DMANIFEST=${_manifest}" "-DITEMS=${_items_arg}"
              -P ${PROJECT_SOURCE_DIR}/cmake/InstallerPayload.cmake
      COMMAND ${CMAKE_COMMAND} -E touch ${_stamp}
      DEPENDS Installer ${_item_targets} ${_mcpbs} ${_manifest} ${PROJECT_SOURCE_DIR}/cmake/InstallerPayload.cmake
      COMMENT "The installer's payload: ${_names}"
      VERBATIM)
  add_custom_target(installer_payload ALL DEPENDS ${_stamp})
  set_property(GLOBAL APPEND PROPERTY FP_SIGNED_BUNDLES "$<TARGET_BUNDLE_DIR:Installer>")

  # ---- the probes: Tools/probes/installer/, one executable, each test once ------------------------------------------
  file(GLOB _probe_src CONFIGURE_DEPENDS ${FP_PROBE_ROOT}/installer/*.cpp)
  fp_read_probes(_probe_names ${_probe_src})
  set(_probes Installer_probes)
  juce_add_console_app(${_probes} PRODUCT_NAME "${_probes}" VERSION ${_version})
  target_sources(${_probes} PRIVATE ${_engine_src} ${_probe_src} ${FP_PROBE_ROOT}/common/ProbeMain.cpp)
  fp_warn_sources(${_probe_src})
  target_include_directories(${_probes} PRIVATE ${FP_SOURCE_ROOT} ${_gen} ${FP_PROBE_ROOT}/common)
  target_compile_definitions(${_probes} PRIVATE JUCE_WEB_BROWSER=0 JUCE_USE_CURL=0
                                                PROBE_DEFAULT_OUT_DIR="${CMAKE_BINARY_DIR}/probe-out/installer")
  target_link_libraries(${_probes} PRIVATE fp_flags juce::juce_gui_basics FunkGui::core FunkGui::harness
                                           "-framework Security" "-framework CoreFoundation"
                                   PUBLIC juce::juce_recommended_config_flags)
  funkgui_configure_product(${_probes} PRODUCT "${FP_INSTALLER_NAME}" OBJC_PREFIX ${_objc}Probes ENV_PREFIX ${_env}
                            PREFS_FOLDER "${FP_INSTALLER_NAME}")
  set_target_properties(${_probes} PROPERTIES EXCLUDE_FROM_ALL TRUE RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
  add_dependencies(probes ${_probes})
  foreach(_name IN LISTS _probe_names)
    add_test(NAME ${_name}
             COMMAND $<TARGET_FILE:${_probes}> ${_name}
                     --golden-root ${PROJECT_SOURCE_DIR}/tests/golden --arch arm64
                     --bless-to ${CMAKE_BINARY_DIR}/golden-candidates/installer
                     --results ${CMAKE_BINARY_DIR}/probe-results/installer)
    set_tests_properties(${_name} PROPERTIES
        LABELS "probe;installer"
        TIMEOUT ${FP_PROBE_TIMEOUT_${_name}}
        ENVIRONMENT "PROBE_OUT_DIR=${CMAKE_BINARY_DIR}/probe-out/installer;${_env}PREFS_DIR=${CMAKE_BINARY_DIR}/sandbox/installer/${_name}")
  endforeach()

  message(STATUS "installer: ${FP_INSTALLER_NAME} ${_version} (${_bundle_id}), its payload ${_names}; probes "
                 "${_probe_names}")
endfunction()
